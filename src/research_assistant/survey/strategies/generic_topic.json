    {"filter": "title.search:{topic}", "kind": "topic_recent", "priority": 2, "purpose": "recent_follow_up", "sort": "publication_date:desc"},
    {"filter": "title.search:{topic}", "kind": "topic_method", "priority": 3, "purpose": "direct_method", "sort": "cited_by_count:desc"}
  ]
}
