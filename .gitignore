# Generated validation and run output. Promotion/claim evidence is kept as
# explicitly force-added compact records; raw payloads and replay transcripts
# remain local and reproducible.
docs/validation/*
!docs/validation/.gitkeep

# New planning/review notes are generated session artifacts. Existing tracked
# history remains tracked; current promotion/claim records are force-added by
# the closeout commit when they are selected as durable evidence.
docs/plans/*
docs/reviews/*

